#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/capstone-worker-startup.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release google-cloud-cli

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

if [[ "${enable_gvisor}" == "true" ]]; then
  release="$(date +%Y%m%d)"
  tmp_dir="$(mktemp -d)"
  curl -fsSL -o "$tmp_dir/runsc" "https://storage.googleapis.com/gvisor/releases/release-$release/x86_64/runsc"
  curl -fsSL -o "$tmp_dir/runsc.sha512" "https://storage.googleapis.com/gvisor/releases/release-$release/x86_64/runsc.sha512"
  (cd "$tmp_dir" && sha512sum -c runsc.sha512)
  install -m 0755 "$tmp_dir/runsc" /usr/local/bin/runsc
  mkdir -p /etc/docker
  cat > /etc/docker/daemon.json <<'JSON'
{
  "runtimes": {
    "runsc": {
      "path": "/usr/local/bin/runsc",
      "runtimeArgs": []
    }
  }
}
JSON
  systemctl restart docker
fi

gcloud auth configure-docker '${region}-docker.pkg.dev' --quiet

for image in python-runner js-runner go-runner java-runner; do
  docker pull '${image_base}/capstone-'"$image"':${image_tag}'
  docker tag '${image_base}/capstone-'"$image"':${image_tag}' 'capstone-'"$image"':latest'
done

mkdir -p /opt/capstone
gcloud storage cp '${worker_artifact_uri}' /tmp/capstone-worker.tar.gz
tar -xzf /tmp/capstone-worker.tar.gz -C /opt/capstone
chmod 0755 /opt/capstone/worker

cp_key="$(gcloud secrets versions access latest --secret='${control_plane_key_secret}')"

cat > /etc/capstone-worker.env <<EOF
ENVIRONMENT=${environment}
WORKER_CP_URL=${control_plane_url}
WORKER_CP_KEY=$cp_key
WORKER_LANGUAGES=${worker_languages}
WORKER_CAPACITY=${worker_capacity}
WORKER_EXECUTOR=docker
WORKER_DOCKER_RUNTIME=${worker_docker_runtime}
WORKER_ALLOW_STUB_EXECUTOR=false
WORKER_HEARTBEAT_INTERVAL_SEC=10
WORKER_POLL_INTERVAL_SEC=2
WORKER_LEASE_RENEWAL_INTERVAL_SEC=20
EOF
chmod 0600 /etc/capstone-worker.env

cat > /etc/systemd/system/capstone-worker.service <<'EOF'
[Unit]
Description=Capstone execution worker
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/capstone-worker.env
ExecStart=/opt/capstone/worker
Restart=always
RestartSec=5
WorkingDirectory=/opt/capstone

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now capstone-worker.service
